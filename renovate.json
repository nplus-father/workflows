{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Taipei",
  "schedule": ["0 0 1 */3 *"],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "pr",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Group ALL updates into a single PR and automerge",
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pin"],
      "groupName": "all dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "nplus-book-core indirect updates",
      "matchPackageNames": ["github.com/nplus-father/nplus-book-core"],
      "matchDepTypes": ["indirect"],
      "groupName": "all dependencies",
      "enabled": true
    },
    {
      "description": "book convention plugin from GitHub Packages",
      "matchPackageNames": ["com.andrewnplus.book"],
      "registryUrls": ["https://maven.pkg.github.com/nplus-father/book-gradle-conventions"]
    }
  ],
  "hostRules": [
    {
      "description": "Auth for book-gradle-conventions on GitHub Packages (requires PACKAGES_TOKEN secret with read:packages in Mend)",
      "matchHost": "maven.pkg.github.com",
      "hostType": "maven",
      "username": "nplus-father",
      "password": "{{ secrets.PACKAGES_TOKEN }}"
    }
  ],
  "gomod": {
    "enabled": true,
    "postUpdateOptions": ["gomodTidy"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Hugo version in GitHub Actions workflows",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["hugo-version:\\s*['\"]?(?<currentValue>[0-9.]+)['\"]?"],
      "depNameTemplate": "gohugoio/hugo",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
